<?xml version="1.0" encoding="utf-8"?>
<!--
    JUNO Splash Interpolator — EmphasizedDecelerate curve
    Approximates Material 3 EmphasizedDecelerate: cubic-bezier(0.05, 0.7, 0.1, 1.0)
    Used by the animated splash icon for scale and alpha transitions.
    
    The path interpolator control points translate the cubic-bezier directly:
    cubicTo(0.05, 0.7, 0.1, 1.0) from (0,0) to (1,1)
-->
<pathInterpolator
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:controlX1="0.05"
    android:controlY1="0.7"
    android:controlX2="0.1"
    android:controlY2="1.0" />
