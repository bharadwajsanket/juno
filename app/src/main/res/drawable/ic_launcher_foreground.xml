<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        JUNO Brand Identity — Singularity × Halo × Orbit
        Viewport: 108×108dp (Android adaptive icon standard)
        Safe zone: central 72dp circle (18dp inset each side)
        All logo elements are drawn within the safe zone.

        Layers (bottom to top):
          1. Singularity — near-black filled inner circle
          2. Halo outer glow — wide faint ring stroke
          3. Halo main ring — primary luminous purple stroke
          4. Halo inner highlight — thin bright inner edge stroke
          5. Orbit satellite — white filled dot at ~1 o'clock

        The "splash_group" name enables ic_splash_animated.xml to target this group
        for the splash screen scale + alpha animation.
    -->

    <!-- Named group: targeted by ic_splash_animated.xml for the launch animation.
         pivotX/pivotY set to the viewport centre for accurate scale-from-centre. -->
    <group
        android:name="splash_group"
        android:pivotX="54"
        android:pivotY="54">

        <!-- Centre coordinates: 54, 54. Ring radius: 22dp. Safe zone: 18–90dp -->

        <!-- 1. Singularity — filled inner dark circle -->
        <path
            android:fillColor="#0D0B12"
            android:pathData="M 54,32 A 22,22 0 1,0 54,76 A 22,22 0 1,0 54,32 Z" />

        <!-- 2. Halo outer glow — wide faint aura -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#7B5EA7"
            android:strokeWidth="5.5"
            android:strokeAlpha="0.22"
            android:strokeLineCap="round"
            android:pathData="M 54,30 A 24,24 0 1,0 54,78 A 24,24 0 1,0 54,30 Z" />

        <!-- 3. Halo main ring — primary luminous purple stroke -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#9F86C0"
            android:strokeWidth="2.2"
            android:strokeAlpha="0.95"
            android:strokeLineCap="round"
            android:pathData="M 54,32 A 22,22 0 1,0 54,76 A 22,22 0 1,0 54,32 Z" />

        <!-- 4. Halo inner highlight — thin bright inner rim -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#C5B0E8"
            android:strokeWidth="0.8"
            android:strokeAlpha="0.60"
            android:strokeLineCap="round"
            android:pathData="M 54,33.5 A 20.5,20.5 0 1,0 54,74.5 A 20.5,20.5 0 1,0 54,33.5 Z" />

        <!-- 5. Orbit satellite — white dot at ~1 o'clock position
             Using angle = 30° from positive-x axis (upper-right):
             x = 54 + 22*cos(30°) = 54 + 19.05 ≈ 73.05
             y = 54 - 22*sin(30°) = 54 - 11 = 43.0
        -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 73.05,40.7 A 3.0,3.0 0 1,0 73.05,46.7 A 3.0,3.0 0 1,0 73.05,40.7 Z" />

        <!-- Satellite subtle glow halo -->
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.18"
            android:pathData="M 73.05,38.7 A 5.0,5.0 0 1,0 73.05,48.7 A 5.0,5.0 0 1,0 73.05,38.7 Z" />

    </group>

</vector>
