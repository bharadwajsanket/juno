<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        JUNO Monochrome Icon — Android 13+ Themed Icon Layer
        Pure white paths only. No colour. The system applies the theme tint.
        Same geometry as ic_launcher_foreground.xml.
    -->

    <!-- 1. Singularity — dark filled inner circle (system will tint to match wallpaper contrast) -->
    <path
        android:fillColor="#000000"
        android:pathData="M 54,32 A 22,22 0 1,0 54,76 A 22,22 0 1,0 54,32 Z" />

    <!-- 2. Halo outer glow ring (faint) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeAlpha="0.18"
        android:strokeLineCap="round"
        android:pathData="M 54,30 A 24,24 0 1,0 54,78 A 24,24 0 1,0 54,30 Z" />

    <!-- 3. Halo main ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M 54,32 A 22,22 0 1,0 54,76 A 22,22 0 1,0 54,32 Z" />

    <!-- 4. Halo inner highlight -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.8"
        android:strokeAlpha="0.50"
        android:strokeLineCap="round"
        android:pathData="M 54,33.5 A 20.5,20.5 0 1,0 54,74.5 A 20.5,20.5 0 1,0 54,33.5 Z" />

    <!-- 5. Orbit satellite dot at ~1 o'clock -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 73.05,40.7 A 3.0,3.0 0 1,0 73.05,46.7 A 3.0,3.0 0 1,0 73.05,40.7 Z" />

</vector>
