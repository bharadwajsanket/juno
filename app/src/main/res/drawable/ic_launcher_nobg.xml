<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        JUNO No-Background Icon — used in contexts without adaptive icon clipping.
        Same artwork as ic_launcher_foreground.xml but rendered on a transparent canvas
        so it can be placed anywhere without the adaptive icon shape mask.
    -->

    <!-- 1. Singularity — filled inner dark circle -->
    <path
        android:fillColor="#0D0B12"
        android:pathData="M 54,32 A 22,22 0 1,0 54,76 A 22,22 0 1,0 54,32 Z" />

    <!-- 2. Halo outer glow -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#7B5EA7"
        android:strokeWidth="5.5"
        android:strokeAlpha="0.22"
        android:strokeLineCap="round"
        android:pathData="M 54,30 A 24,24 0 1,0 54,78 A 24,24 0 1,0 54,30 Z" />

    <!-- 3. Halo main ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#9F86C0"
        android:strokeWidth="2.2"
        android:strokeAlpha="0.95"
        android:strokeLineCap="round"
        android:pathData="M 54,32 A 22,22 0 1,0 54,76 A 22,22 0 1,0 54,32 Z" />

    <!-- 4. Halo inner highlight -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#C5B0E8"
        android:strokeWidth="0.8"
        android:strokeAlpha="0.60"
        android:strokeLineCap="round"
        android:pathData="M 54,33.5 A 20.5,20.5 0 1,0 54,74.5 A 20.5,20.5 0 1,0 54,33.5 Z" />

    <!-- 5. Orbit satellite dot at ~1 o'clock -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 73.05,40.7 A 3.0,3.0 0 1,0 73.05,46.7 A 3.0,3.0 0 1,0 73.05,40.7 Z" />

    <!-- Satellite subtle glow -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.18"
        android:pathData="M 73.05,38.7 A 5.0,5.0 0 1,0 73.05,48.7 A 5.0,5.0 0 1,0 73.05,38.7 Z" />

</vector>
